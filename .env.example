# Project name
PROJECT_NAME=sari_iiif_manifest

# Path to configuration yml file
CONFIG_YML=/config/default.yml

# SPARQL endpoint URL
SPARQL_ENDPOINT=http://blazegraph:8080/blazegraph/sparql

# Optional SPARQL authentication settings
SPARQL_HTTP_AUTH=BASIC
SPARQL_USERNAME=
SPARQL_PASSWORD=
SPARQL_BEARER_TOKEN=
SPARQL_TIMEOUT=30
SPARQL_REQUEST_METHOD=GET # GET or POST

# Docker network (if any) where the SPARQL endpoint is reachable
DOCKER_NETWORK=name_of_network_with_endpoint

### Development or Production settings

# Development
COMPOSE_FILE=./docker-compose.yml:./docker-compose.dev.yml
PORT_DEV=5000

# Production
#COMPOSE_FILE=./docker-compose.yml:./docker-compose.prod.yml
PROXY_NETWORK_NAME=nginx_proxy_network
HOST_NAME=iiif.example.org
LETSENCRYPT_EMAIL=xxx